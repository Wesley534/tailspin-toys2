---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const database = getDatabase();
const games = await getAllGames(database);
const categories = await getAllCategories(database);
const publishers = await getAllPublishers(database);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        {games.length > 0 && (
          <button
            type="button"
            class="self-start rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 sm:self-auto"
            data-testid="reset-filters"
          >
            Reset filters
          </button>
        )}
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <section
            aria-labelledby="filter-heading"
            class="mb-8 rounded-xl border border-slate-700 bg-slate-800/50 p-5"
            data-testid="game-filters"
          >
            <h3 id="filter-heading" class="mb-4 text-lg font-medium text-slate-100">Filter games</h3>
            <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(12rem,16rem)]">
              <fieldset>
                <legend class="mb-2 text-sm font-medium text-slate-200">Categories</legend>
                <div class="flex flex-wrap gap-x-5 gap-y-3">
                  {categories.map((category) => (
                    <label
                      for={`category-filter-${category.id}`}
                      class="inline-flex items-center gap-2 text-sm text-slate-300"
                    >
                      <input
                        type="checkbox"
                        id={`category-filter-${category.id}`}
                        value={category.id}
                        data-category-filter={category.id}
                        data-testid={`category-filter-${category.id}`}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                      />
                      {category.name}
                    </label>
                  ))}
                </div>
              </fieldset>
              <div>
                <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">
                  Publisher
                </label>
                <select
                  id="publisher-filter"
                  data-testid="publisher-filter"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
              </div>
            </div>
            <p class="mt-4 text-sm text-slate-400" data-testid="filter-results" aria-live="polite">
              Showing {games.length} {games.length === 1 ? 'game' : 'games'}
            </p>
          </section>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filter-empty" aria-live="polite">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const categoryFilters = Array.from(document.querySelectorAll<HTMLInputElement>('[data-category-filter]'));
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-testid="reset-filters"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-results"]');

  const updateResults = (): void => {
    const selectedCategories = categoryFilters
      .filter((filter) => filter.checked)
      .map((filter) => filter.value);
    const selectedPublisher = publisherFilter?.value ?? '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const categoryMatches =
        selectedCategories.length === 0 ||
        selectedCategories.includes(card.dataset.gameCategoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' ||
        card.dataset.gamePublisherId === selectedPublisher;
      const isVisible = categoryMatches && publisherMatches;

      card.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });

    if (emptyState) emptyState.classList.toggle('hidden', visibleCount > 0);
    if (resultCount) {
      resultCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    }
  };

  categoryFilters.forEach((filter) => filter.addEventListener('change', updateResults));
  publisherFilter?.addEventListener('change', updateResults);
  resetButton?.addEventListener('click', () => {
    categoryFilters.forEach((filter) => {
      filter.checked = false;
    });
    if (publisherFilter) publisherFilter.value = '';
    updateResults();
  });
</script>
